# =============================================================================
# Graspr Backend — variables d'environnement
# Copier en `.env` et renseigner. NE JAMAIS committer le `.env` rempli.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CORE (valeurs par défaut si absentes)
# ─────────────────────────────────────────────────────────────────────────────
# Port d'écoute HTTP (défaut : 3100)
PORT=
# development | production | test (défaut : development)
NODE_ENV=

# ─────────────────────────────────────────────────────────────────────────────
# CRITIQUE — l'application REFUSE de démarrer si une de ces variables manque
# (validé au boot par Joi, cf. src/config/validation/index.ts)
# ─────────────────────────────────────────────────────────────────────────────
# URL du projet Supabase (ex. https://xxxx.supabase.co)
SUPABASE_URL=
# Clé service-role Supabase (backend uniquement — SECRET, ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_SECRET=
# Secret JWT Supabase — utilisé par la garde Bearer pour valider les tokens (HS256)
SUPABASE_JWT_SECRET=
# Secret de signature des sessions express-session (chaîne aléatoire longue)
EXPRESS_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONNEL PAR FEATURE — l'app démarre sans ; la feature concernée échoue/se
# désactive proprement si sa clé manque
# ─────────────────────────────────────────────────────────────────────────────

# --- IA : chat, résumés, quiz, flashcards, embeddings/RAG, transcription ---
# Embeddings OpenAI (RAG)
OPENAI_API_KEY=
# Anthropic Claude (chat, résumés, quiz, flashcards) — lu par le SDK @langchain/anthropic
ANTHROPIC_API_KEY=
# Modèle Claude (défaut applicatif : claude-haiku-4-5-20251001)
ANTHROPIC_MODEL_ID=
# Groq Whisper (transcription audio)
GROQ_API_KEY=

# --- Stockage fichiers (AWS S3) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Nodemailer — envoi des OTP) ---
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# --- Vidéo (import / transcript YouTube) ---
GOOGLE_YOUTUBE_API_KEY=
SUPADATA_AI_KEY=

# --- Génération de vidéos (Knowlify) ---
KNOWLIFY_API_HOST=
KNOWLIFY_API_KEY=

# --- Analytics : Amplitude ---
# 'true' pour activer l'envoi
AMPLITUDE_ENABLED=
AMPLITUDE_API_KEY=

# --- Analytics / engagement : Customer.io ---
# 'true' pour activer l'envoi
CUSTOMERIO_ENABLED=
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# --- Dashboard admin-stats (Basic Auth) ---
ADMIN_STATS_BASIC_AUTH_LOGIN=
ADMIN_STATS_BASIC_AUTH_PASS=

# --- URLs / redirections ---
# URL du front (redirections Stripe, liens dans les emails)
WEBSITE_URL=
# URL publique du backend (liens de confirmation auth)
BACKEND_URL=

# --- Jobs asynchrones (worker in-process) — tous optionnels, défauts entre parenthèses ---
# 'false' pour désactiver le worker dans ce process (ex. conteneur worker dédié plus tard)
JOBS_WORKER_ENABLED=
# Intervalle de polling en ms (2000)
JOBS_POLL_INTERVAL_MS=
# Nombre de jobs traités en parallèle (1)
JOBS_CONCURRENCY=
# Nombre de tentatives avant échec définitif (3)
JOBS_MAX_ATTEMPTS=

# --- Documents (ingestion) — optionnels, défauts entre parenthèses ---
# Taille max d'un PDF uploadé, en Mo (100). Garde-fou infra : extraction en mémoire,
# worker dans le même conteneur que l'API (EB mono-conteneur) — borne l'OOM, pas une règle produit.
DOCUMENTS_PDF_MAX_SIZE_MB=
