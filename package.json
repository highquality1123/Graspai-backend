  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node scripts/lint.js",
    "lint:check": "eslint --max-warnings 0",
    "format:check": "prettier --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint:api": "npx --yes @redocly/cli@2.36.0 lint openapi.yaml",
    "lint:api:en": "npx --yes @redocly/cli@2.36.0 lint openapi.en.yaml",
    "docs:api": "npx --yes @redocly/cli@2.36.0 build-docs openapi.yaml -o openapi.html",
    "docs:api:en": "npx --yes @redocly/cli@2.36.0 build-docs openapi.en.yaml -o openapi.en.html"
  },
  "dependencies": {
