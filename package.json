    "axios": "^1.18.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express-session": "^1.18.1",
    "fetch-blob": "^4.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "gpt-3-encoder": "^1.1.4",
